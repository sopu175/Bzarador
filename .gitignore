# ==============================================================================
# Bazar-Dor (.gitignore)
# Keep only essential application source code & configurations
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/
*.tsbuildinfo

# Environment & Secrets (Never commit credentials)
.env
.env*.local
.env.production
.env.staging
!.env.example

# Development Logs & Process IDs
*.log
*.log*
*.pid
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database Snapshots & Journals
# (Note: custom.db in root db/ is committed as initial baseline SQLite storage)
db/*.db-journal
db/backups/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Directories
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.settings/

# Cloud, Vercel & Container Tooling
.vercel/
.vercel
.claude/
.z-ai-config/
.agents/
/skills/

# Scaffold, Sandboxing & Scratch Files (Not part of Bazar-Dor core app)
.zscripts/
mini-services/
examples/
tests/
download/
upload/
Caddyfile
worklog.md
scratch/
test/
prompt/
