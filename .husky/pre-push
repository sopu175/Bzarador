echo "🔍 [pre-push] Verifying code quality before pushing..."

# 1. Format check
echo "  ↳ 1/3 Checking code formatting (Prettier)..."
bun run format:check || {
  echo "❌ Prettier check failed! Run 'bun run format' to fix."
  exit 1
}

# 2. Lint check
echo "  ↳ 2/3 Checking lint rules (ESLint)..."
bun run lint || {
  echo "❌ ESLint check failed! Run 'bun run lint:fix' or fix errors."
  exit 1
}

# 3. TypeScript type check
echo "  ↳ 3/3 Checking TypeScript types (tsc)..."
bun x tsc --noEmit || {
  echo "❌ TypeScript check failed! Push aborted."
  exit 1
}

echo "✅ All code quality gates passed! Proceeding with git push."
