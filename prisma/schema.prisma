// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Kitchen market items: vegetables, fish, meat, fruits, spices, rice, lentils, oil
model Item {
  id        String   @id @default(cuid())
  nameBn    String
  nameEn    String
  category  String   // vegetable | fish | meat | fruit | spice | rice | lentil | oil
  unit      String   // kg | piece | litre | dozen
  emoji     String   @default("🥬")
  createdAt DateTime @default(now())

  reports   PriceReport[]
  alerts    PriceAlert[]
}

// A physical kitchen market (bazar) in a district/upazila
model Market {
  id        String   @id @default(cuid())
  nameBn    String
  nameEn    String
  district  String   // e.g. "Dhaka", "Chattogram"
  upazila   String   // e.g. "Dhaka South", "Mirpur"
  createdAt DateTime @default(now())

  reports   PriceReport[]
}

// A user-reported price for an item at a market on a given day
model PriceReport {
  id            String   @id @default(cuid())
  itemId        String
  marketId      String
  price         Float    // price per unit in Taka
  reporterName  String   @default("Anonymous")
  reporterPhone String?
  reportedAt    DateTime @default(now())

  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([itemId, marketId, reportedAt])
  @@index([marketId, reportedAt])
}

// A user-requested alert when an item's price crosses a threshold
model PriceAlert {
  id           String   @id @default(cuid())
  itemId       String
  marketId     String?
  targetPrice  Float
  direction    String   // below | above
  phone        String
  createdAt    DateTime @default(now())

  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
