# SQLite Database (Standard Prisma relative path relative to prisma/schema.prisma)
DATABASE_URL="file:../db/custom.db"

# Gmail SMTP Configuration
# Instructions:
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to 'App passwords' (myaccount.google.com/apppasswords)
# 3. Create a password named 'Bazar Dam' and paste the 16-letter password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="বাজার দাম <your-email@gmail.com>"

# Google Analytics (GA4) & Google Tag Manager (GTM)
# Paste your tracking IDs below to enable analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="" # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=""            # e.g. GTM-XXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_ENGLISH_SEARCH="true" # Set "false" to disable search by English keywords
